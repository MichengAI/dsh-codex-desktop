{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "src/**/*.mts",
    "src/**/*.cts",
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
